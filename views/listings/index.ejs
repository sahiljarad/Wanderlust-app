<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    
  }

  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.7;
  }

  .filter:hover{
    opacity: 1;
    cursor: pointer;
  }

  .filter p{
    font-size: 0.8rem;
  }

  .tax-info{
    display: none;
  }

  .tax-toggle {
 border: 1px solid black;
 border-radius: 1rem;
 height: 3.20rem;
 padding: 1rem;
 /* margin-top: 0.8rem; */
 margin-left: 2rem;
 display: flex;
 align-items: center;
}


  
</style>

<div id="filters">
  <div class="filter">
    <i class="fa-solid fa-fire"></i>
    <p>Trending</p>
  </div>

  <div class="filter">
    <i class="fa-solid fa-bed"></i>
    <p>Rooms</p>
    
  </div>

  <div class="filter">
   <i class="fa-solid fa-mountain-city"></i>
    <p>iconic citiy</p>
    
  </div>

  <div class="filter">
     <i class="fa-solid fa-mountain"></i>
    <p>mountain</p>
    
  </div>

   <div class="filter">
     <i class="fa-solid fa-chess-rook"></i>
    <p>castles</p>
    
  </div>

  <div class="filter">
<i class="fa-solid fa-person-swimming"></i>
    <p>amazing pools</p>
    
  </div>

  <div class="filter">
<i class="fa-solid fa-campground"></i>
    <p>camping</p>
    
  </div>

  <div class="filter">
<i class="fa-solid fa-money-bill-wheat"></i>
    <p>farms</p>
    
  </div>

  <div class="filter">
<i class="fa-solid fa-tractor"></i>
    <p>Tractor</p>
    
  </div>

   <div class="filter">
<i class="fa-solid fa-sailboat"></i>
    <p>Boats</p>
    
  </div>

   <div class="filter">
<i class="fa-solid fa-landmark-dome"></i>
    <p>Dome</p>
    
  </div>


  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
  <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
  <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
</div>
  </div>
</div>


<div class="container my-5">
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% for (let listing of alllistings) { %>
      <div class="col">
        <div class="card h-100 shadow-sm border-none">
          <img
            src="<%= listing.image?.url || 'https://via.placeholder.com/300' %>"
            class="card-img-top"
            alt="listing image"
            style="height: 200px; object-fit: cover;"
          >
          <div class="card-overlay"></div>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold"><%= listing.title %></h5>
            <p class="card-text text-truncate fst-italic"><%= listing.description %></p>
<div class="d-flex justify-content-between align-items-center">
  <p class="card-text fw-bold m-0">
    <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %>
  </p>

  <span class="text-muted small">
    <i class="tax-info">+18% GST</i>
  </span>
</div>


            
             
            <a href="/listing/<%= listing._id %>" class="btn btn-primary mt-2">View</a>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>


